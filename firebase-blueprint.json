{
  "entities": {
    "Character": {
      "title": "Character",
      "description": "A character dossier in xocyberluv's character archive.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Accession identifier such as ARC-001"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Character display name"
        },
        "image": {
          "type": "string",
          "maxLength": 250000,
          "description": "Portrait image path, HTTPS URL, or compressed data URL"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Short character epithet or subtitle"
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Primary category or genre name"
        },
        "tags": {
          "type": "array",
          "description": "Up to 15 descriptive tags"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Short character description"
        },
        "plot": {
          "type": "string",
          "maxLength": 15000,
          "description": "Long-form character story or plot"
        },
        "link": {
          "type": "string",
          "maxLength": 1000,
          "description": "External character link"
        },
        "linkLabel": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional external button label"
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the character is featured/pinned by admin"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Admin UID who created this record"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp"
        }
      },
      "required": [
        "id",
        "name",
        "image",
        "subtitle",
        "genre",
        "tags",
        "description",
        "plot",
        "link",
        "pinned",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "An editorial category managed by administrators.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Category display name"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_\\-]+$",
          "description": "Normalized slug"
        },
        "order": {
          "type": "number",
          "description": "Display sort order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "slug", "order", "createdAt", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "An independent decorative gallery image.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250000
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "maxLength": 60
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "span": {
          "type": "string",
          "enum": ["tall", "wide", "standard"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["image", "caption", "date", "category", "span", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile containing PII (email) and server-governed role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "photoURL": {
          "type": "string",
          "maxLength": 250000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "username", "email", "role", "createdAt", "updatedAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "A member's personal saved favorite character reference.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "characterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "characterId", "createdAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Non-PII username uniqueness reservation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted admin allowlist document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "Track": {
      "title": "Track",
      "description": "An audio track in the archive background music library managed exclusively by admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "cover": {
          "type": "string",
          "maxLength": 250000
        },
        "audioType": {
          "type": "string",
          "enum": ["chunks", "url"]
        },
        "audioUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "audioMimeType": {
          "type": "string",
          "maxLength": 80
        },
        "audioFileName": {
          "type": "string",
          "maxLength": 180
        },
        "audioFileSize": {
          "type": "number"
        },
        "audioChunkCount": {
          "type": "number"
        },
        "audioVersion": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "order": {
          "type": "number"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "artist",
        "description",
        "cover",
        "audioType",
        "audioUrl",
        "audioMimeType",
        "audioFileName",
        "audioFileSize",
        "audioChunkCount",
        "audioVersion",
        "duration",
        "order",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "TrackAudioChunk": {
      "title": "TrackAudioChunk",
      "description": "An ordered base64 binary chunk of an admin-uploaded audio file stored under its parent track.",
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkIndex": {
          "type": "number"
        },
        "audioVersion": {
          "type": "number"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["trackId", "chunkIndex", "audioVersion", "data", "createdAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Non-PII public display identity (displayName, username, photoURL, verified role) synced across the Forum and Header.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_\\-]+$" },
        "photoURL": { "type": "string", "maxLength": 250000 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "username", "photoURL", "role", "updatedAt"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "A community or admin forum post with backend-enforced pin, feature, and authorRole controls.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorRole": { "type": "string", "enum": ["user", "admin"] },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorUsername": { "type": "string", "minLength": 1, "maxLength": 32 },
        "authorPhotoURL": { "type": "string", "maxLength": 250000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "content": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "image": { "type": "string", "maxLength": 250000 },
        "isPinned": { "type": "boolean" },
        "pinnedAt": { "type": "number" },
        "pinOrder": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isImportant": { "type": "boolean" },
        "importantAnnouncedAt": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "authorId", "authorRole", "authorName", "authorUsername", "authorPhotoURL",
        "title", "content", "image", "isPinned", "pinnedAt", "pinOrder", "isFeatured",
        "createdAt", "updatedAt"
      ]
    },
    "ForumComment": {
      "title": "ForumComment",
      "description": "A comment or nested reply on a forum post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentCommentId": { "type": "string", "maxLength": 64 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorRole": { "type": "string", "enum": ["user", "admin"] },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorUsername": { "type": "string", "minLength": 1, "maxLength": 32 },
        "authorPhotoURL": { "type": "string", "maxLength": 250000 },
        "content": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "postId", "parentCommentId", "authorId", "authorRole",
        "authorName", "authorUsername", "authorPhotoURL", "content",
        "createdAt", "updatedAt"
      ]
    },
    "ForumLike": {
      "title": "ForumLike",
      "description": "A unique per-user like record on a forum post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "createdAt"]
    },
    "ForumRulesConfig": {
      "title": "ForumRulesConfig",
      "description": "Versioned community rules shown before entering the Forum.",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "intro": { "type": "string", "maxLength": 500 },
        "rules": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "title", "intro", "rules", "updatedBy", "updatedAt"]
    },
    "ForumRulesAcceptance": {
      "title": "ForumRulesAcceptance",
      "description": "Per-account record of accepted forum rules version.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "acceptedVersion": { "type": "number" },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "acceptedVersion", "acceptedAt"]
    },
    "ForumViolation": {
      "title": "ForumViolation",
      "description": "Recorded content moderation warning, flagged excerpt, reason, and appeal state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "userUsername": { "type": "string", "minLength": 1, "maxLength": 32 },
        "userPhotoURL": { "type": "string", "maxLength": 250000 },
        "contentType": { "type": "string", "enum": ["post", "comment", "reply"] },
        "incidentKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "flaggedText": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "categories": { "type": "array" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "strikeNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["unread", "reviewing", "resolved", "dismissed"] },
        "appealRequested": { "type": "boolean" },
        "appealReason": { "type": "string", "maxLength": 1000 },
        "appealStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "appealResolutionNote": { "type": "string", "maxLength": 500 },
        "adminNote": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "userName", "userUsername", "userPhotoURL",
        "contentType", "incidentKey", "flaggedText", "reason", "categories",
        "severity", "strikeNumber", "status", "appealRequested", "appealReason",
        "appealStatus", "appealResolutionNote", "adminNote", "reviewedBy",
        "createdAt", "updatedAt"
      ]
    },
    "UserRestriction": {
      "title": "UserRestriction",
      "description": "Server-enforced account violation counter and temporary posting/commenting/suspension windows.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "warningCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "post_restricted", "comment_restricted", "restricted", "suspended"] },
        "postRestrictedUntil": { "type": "number" },
        "commentRestrictedUntil": { "type": "number" },
        "suspendedUntil": { "type": "number" },
        "reason": { "type": "string", "maxLength": 400 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "warningCount", "status", "postRestrictedUntil",
        "commentRestrictedUntil", "suspendedUntil", "reason", "updatedBy", "updatedAt"
      ]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Private per-account notification for important Admin pinned posts, forum interactions, warnings, and system alerts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["important_post", "interaction", "warning", "system"] },
        "subtype": { "type": "string", "minLength": 1, "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 80 },
        "actorPhotoURL": { "type": "string", "maxLength": 250000 },
        "postId": { "type": "string", "maxLength": 64 },
        "commentId": { "type": "string", "maxLength": 64 },
        "violationId": { "type": "string", "maxLength": 64 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "recipientId", "type", "subtype", "title", "body",
        "actorId", "actorName", "actorPhotoURL", "postId", "commentId",
        "violationId", "isRead", "createdAt"
      ]
    },
    "ImportantAnnouncement": {
      "title": "ImportantAnnouncement",
      "description": "Publicly readable important pinned Admin post announcement for non-intrusive bottom-left popups.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 280 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorPhotoURL": { "type": "string", "maxLength": 250000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "postId", "title", "excerpt", "authorId",
        "authorName", "authorPhotoURL", "active", "createdAt", "updatedAt"
      ]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable append-only accountability record of Admin moderation actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "action": { "type": "string", "minLength": 1, "maxLength": 60 },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "targetUserName": { "type": "string", "maxLength": 80 },
        "targetEntityId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "adminId", "adminName", "action", "targetUserId",
        "targetUserName", "targetEntityId", "summary", "createdAt"
      ]
    }
  },
  "firestore": {
    "/characters/{characterId}": {
      "schema": { "$ref": "#/entities/Character" },
      "description": "Publicly readable character dossiers; create/update/delete restricted to verified admins."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Publicly readable category list; managed exclusively by verified admins."
    },
    "/gallery/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Publicly readable independent decorative image gallery; managed by verified admins."
    },
    "/tracks/{trackId}": {
      "schema": { "$ref": "#/entities/Track" },
      "description": "Publicly readable background music tracks; upload, replace, edit, and delete restricted to verified admins."
    },
    "/tracks/{trackId}/audioChunks/{chunkId}": {
      "schema": { "$ref": "#/entities/TrackAudioChunk" },
      "description": "Publicly readable ordered audio chunks linked to an existing track; immutable; create/delete restricted to verified admins."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "PII-isolated user profiles; readable only by owner or admin; username, email, and role immutable by regular users."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Non-PII public display profiles synced for live avatar, displayName, and verified role across the Forum."
    },
    "/forumPosts/{postId}": {
      "schema": { "$ref": "#/entities/ForumPost" },
      "description": "Publicly readable forum posts; authenticated unrestricted users manage own posts; only verified admins can pin, feature, mark important, or assign admin role."
    },
    "/forumComments/{commentId}": {
      "schema": { "$ref": "#/entities/ForumComment" },
      "description": "Publicly readable forum comments and nested replies; unrestricted users manage own comments; admins may moderate."
    },
    "/forumLikes/{likeId}": {
      "schema": { "$ref": "#/entities/ForumLike" },
      "description": "Publicly readable unique per-user likes keyed by {postId}_{userId}."
    },
    "/forumRulesConfig/{docId}": {
      "schema": { "$ref": "#/entities/ForumRulesConfig" },
      "description": "Versioned community rules document ('current'); public read, admin-only write."
    },
    "/forumRulesAcceptances/{userId}": {
      "schema": { "$ref": "#/entities/ForumRulesAcceptance" },
      "description": "Per-account forum rules version acceptance record; owner/admin read, owner write."
    },
    "/forumViolations/{violationId}": {
      "schema": { "$ref": "#/entities/ForumViolation" },
      "description": "Recorded content warnings, blocked drafts, and appeal requests; owner or admin read; admin moderates."
    },
    "/userRestrictions/{userId}": {
      "schema": { "$ref": "#/entities/UserRestriction" },
      "description": "Per-account warning count and time-bound posting/commenting/suspension windows; backend-enforced on forum writes."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Strictly private per-recipient notifications for important posts, interactions, warnings, and system alerts."
    },
    "/importantAnnouncements/{announcementId}": {
      "schema": { "$ref": "#/entities/ImportantAnnouncement" },
      "description": "Publicly readable important Admin pinned post announcements keyed by postId; admin-only write."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable append-only audit trail of Admin moderation actions; admin-only read/create."
    },
    "/users/{userId}/favorites/{characterId}": {
      "schema": { "$ref": "#/entities/UserFavorite" },
      "description": "Member-only personal favorite bookmarks linked to existing characters."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameClaim" },
      "description": "Non-PII username reservations ensuring unique usernames."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Trusted administrator grant documents."
    }
  }
}
