rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'lailameowdayy@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(username) {
      return username is string && username.size() >= 3 && username.size() <= 32 && username.matches('^[a-z0-9_\\-]+$');
    }

    function isPostRestrictedNow() {
      return exists(/databases/$(database)/documents/userRestrictions/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/userRestrictions/$(request.auth.uid)).data.suspendedUntil > request.time.toMillis() ||
        get(/databases/$(database)/documents/userRestrictions/$(request.auth.uid)).data.postRestrictedUntil > request.time.toMillis()
      );
    }

    function isCommentRestrictedNow() {
      return exists(/databases/$(database)/documents/userRestrictions/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/userRestrictions/$(request.auth.uid)).data.suspendedUntil > request.time.toMillis() ||
        get(/databases/$(database)/documents/userRestrictions/$(request.auth.uid)).data.commentRestrictedUntil > request.time.toMillis()
      );
    }

    function isValidCharacter(data) {
      return data.keys().hasAll([
          'id', 'name', 'image', 'subtitle', 'genre', 'tags',
          'description', 'plot', 'link', 'pinned', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'image', 'subtitle', 'genre', 'tags',
          'description', 'plot', 'link', 'linkLabel', 'pinned', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.image is string && data.image.size() <= 250000 &&
        data.subtitle is string && data.subtitle.size() <= 200 &&
        data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 60 &&
        data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
        data.description is string && data.description.size() <= 2000 &&
        data.plot is string && data.plot.size() <= 15000 &&
        data.link is string && data.link.size() <= 1000 &&
        (!('linkLabel' in data) || (data.linkLabel is string && data.linkLabel.size() <= 60)) &&
        data.pinned is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'slug', 'order', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9_\\-]+$') &&
        data.order is number && data.order >= 0 && data.order <= 9999 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['image', 'caption', 'date', 'category', 'span', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['image', 'caption', 'date', 'category', 'span', 'createdAt', 'updatedAt']) &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 250000 &&
        data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 200 &&
        data.date is string && data.date.size() <= 60 &&
        data.category is string && data.category.size() <= 80 &&
        data.span is string && data.span in ['tall', 'wide', 'standard'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrack(data) {
      return data.keys().hasAll([
          'id', 'title', 'artist', 'description', 'cover',
          'audioType', 'audioUrl', 'audioMimeType', 'audioFileName',
          'audioFileSize', 'audioChunkCount', 'audioVersion',
          'duration', 'order', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'artist', 'description', 'cover',
          'audioType', 'audioUrl', 'audioMimeType', 'audioFileName',
          'audioFileSize', 'audioChunkCount', 'audioVersion',
          'duration', 'order', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 120 &&
        data.description is string && data.description.size() <= 400 &&
        data.cover is string && data.cover.size() <= 250000 &&
        data.audioType is string && data.audioType in ['chunks', 'url'] &&
        data.audioUrl is string && data.audioUrl.size() <= 1000 &&
        data.audioMimeType is string && data.audioMimeType.size() <= 80 &&
        data.audioFileName is string && data.audioFileName.size() <= 180 &&
        data.audioFileSize is number && data.audioFileSize >= 0 && data.audioFileSize <= 10485760 &&
        data.audioChunkCount is number && data.audioChunkCount >= 0 && data.audioChunkCount <= 40 &&
        data.audioVersion is number && data.audioVersion >= 1 && data.audioVersion <= 99999 &&
        data.duration is number && data.duration >= 0 && data.duration <= 7200 &&
        data.order is number && data.order >= 0 && data.order <= 99999 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrackAudioChunk(data) {
      return data.keys().hasAll(['trackId', 'chunkIndex', 'audioVersion', 'data', 'createdAt']) &&
        data.keys().hasOnly(['trackId', 'chunkIndex', 'audioVersion', 'data', 'createdAt']) &&
        data.trackId is string && data.trackId.size() >= 1 && data.trackId.size() <= 64 && data.trackId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chunkIndex is number && data.chunkIndex >= 0 && data.chunkIndex <= 40 &&
        data.audioVersion is number && data.audioVersion >= 1 && data.audioVersion <= 99999 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 600000 &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'email', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'username', 'email', 'role', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isValidUsername(data.username) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role is string && data.role in ['user', 'admin'] &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 250000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'photoURL', 'role', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'role', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isValidUsername(data.username) &&
        data.photoURL is string && data.photoURL.size() <= 250000 &&
        data.role is string && data.role in ['user', 'admin'] &&
        data.updatedAt is timestamp;
    }

    function isValidForumPost(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorRole', 'authorName', 'authorUsername', 'authorPhotoURL',
          'title', 'content', 'image', 'isPinned', 'pinnedAt', 'pinOrder', 'isFeatured',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorRole', 'authorName', 'authorUsername', 'authorPhotoURL',
          'title', 'content', 'image', 'isPinned', 'pinnedAt', 'pinOrder', 'isFeatured',
          'isImportant', 'importantAnnouncedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.authorRole is string && data.authorRole in ['user', 'admin'] &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 32 &&
        data.authorPhotoURL is string && data.authorPhotoURL.size() <= 250000 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 10000 &&
        data.image is string && data.image.size() <= 250000 &&
        data.isPinned is bool &&
        data.pinnedAt is number && data.pinnedAt >= 0 &&
        data.pinOrder is number && data.pinOrder >= 0 && data.pinOrder <= 9999 &&
        data.isFeatured is bool &&
        (!('isImportant' in data) || data.isImportant is bool) &&
        (!('importantAnnouncedAt' in data) || (data.importantAnnouncedAt is number && data.importantAnnouncedAt >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidForumComment(data) {
      return data.keys().hasAll([
          'id', 'postId', 'parentCommentId', 'authorId', 'authorRole',
          'authorName', 'authorUsername', 'authorPhotoURL', 'content',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'postId', 'parentCommentId', 'authorId', 'authorRole',
          'authorName', 'authorUsername', 'authorPhotoURL', 'content',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 64 && data.postId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.parentCommentId is string && data.parentCommentId.size() <= 64 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.authorRole is string && data.authorRole in ['user', 'admin'] &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 32 &&
        data.authorPhotoURL is string && data.authorPhotoURL.size() <= 250000 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 3000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidForumLike(data) {
      return data.keys().hasAll(['postId', 'userId', 'createdAt']) &&
        data.keys().hasOnly(['postId', 'userId', 'createdAt']) &&
        data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 64 && data.postId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidForumRulesConfig(data) {
      return data.keys().hasAll(['version', 'title', 'intro', 'rules', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['version', 'title', 'intro', 'rules', 'updatedBy', 'updatedAt']) &&
        data.version is number && data.version >= 1 && data.version <= 99999 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.intro is string && data.intro.size() <= 500 &&
        data.rules is list && data.rules.size() >= 1 && data.rules.size() <= 15 &&
        data.rules[0] is string && data.rules[0].size() <= 300 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidForumRulesAcceptance(data) {
      return data.keys().hasAll(['userId', 'acceptedVersion', 'acceptedAt']) &&
        data.keys().hasOnly(['userId', 'acceptedVersion', 'acceptedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.acceptedVersion is number && data.acceptedVersion >= 1 && data.acceptedVersion <= 99999 &&
        data.acceptedAt is timestamp;
    }

    function isValidForumViolation(data) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'userUsername', 'userPhotoURL',
          'contentType', 'incidentKey', 'flaggedText', 'reason', 'categories',
          'severity', 'strikeNumber', 'status', 'appealRequested', 'appealReason',
          'appealStatus', 'appealResolutionNote', 'adminNote', 'reviewedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'userUsername', 'userPhotoURL',
          'contentType', 'incidentKey', 'flaggedText', 'reason', 'categories',
          'severity', 'strikeNumber', 'status', 'appealRequested', 'appealReason',
          'appealStatus', 'appealResolutionNote', 'adminNote', 'reviewedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.userUsername is string && data.userUsername.size() >= 1 && data.userUsername.size() <= 32 &&
        data.userPhotoURL is string && data.userPhotoURL.size() <= 250000 &&
        data.contentType is string && data.contentType in ['post', 'comment', 'reply'] &&
        data.incidentKey is string && data.incidentKey.size() >= 1 && data.incidentKey.size() <= 128 &&
        data.flaggedText is string && data.flaggedText.size() >= 1 && data.flaggedText.size() <= 3000 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        data.categories is list && data.categories.size() <= 8 && (data.categories.size() == 0 || (data.categories[0] is string && data.categories[0].size() <= 40)) &&
        data.severity is string && data.severity in ['low', 'medium', 'high'] &&
        data.strikeNumber is number && data.strikeNumber >= 0 && data.strikeNumber <= 999 &&
        data.status is string && data.status in ['unread', 'reviewing', 'resolved', 'dismissed'] &&
        data.appealRequested is bool &&
        data.appealReason is string && data.appealReason.size() <= 1000 &&
        data.appealStatus is string && data.appealStatus in ['none', 'pending', 'approved', 'rejected'] &&
        data.appealResolutionNote is string && data.appealResolutionNote.size() <= 500 &&
        data.adminNote is string && data.adminNote.size() <= 500 &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserRestriction(data) {
      return data.keys().hasAll([
          'userId', 'warningCount', 'status', 'postRestrictedUntil',
          'commentRestrictedUntil', 'suspendedUntil', 'reason', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'warningCount', 'status', 'postRestrictedUntil',
          'commentRestrictedUntil', 'suspendedUntil', 'reason', 'updatedBy', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.warningCount is number && data.warningCount >= 0 && data.warningCount <= 999 &&
        data.status is string && data.status in ['active', 'post_restricted', 'comment_restricted', 'restricted', 'suspended'] &&
        data.postRestrictedUntil is number && data.postRestrictedUntil >= 0 &&
        data.commentRestrictedUntil is number && data.commentRestrictedUntil >= 0 &&
        data.suspendedUntil is number && data.suspendedUntil >= 0 &&
        data.reason is string && data.reason.size() <= 400 &&
        data.updatedBy is string && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidUserNotification(data) {
      return data.keys().hasAll([
          'id', 'recipientId', 'type', 'subtype', 'title', 'body',
          'actorId', 'actorName', 'actorPhotoURL', 'postId', 'commentId',
          'violationId', 'isRead', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'recipientId', 'type', 'subtype', 'title', 'body',
          'actorId', 'actorName', 'actorPhotoURL', 'postId', 'commentId',
          'violationId', 'isRead', 'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
        data.type is string && data.type in ['important_post', 'interaction', 'warning', 'system'] &&
        data.subtype is string && data.subtype.size() >= 1 && data.subtype.size() <= 40 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
        data.actorId is string && data.actorId.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 80 &&
        data.actorPhotoURL is string && data.actorPhotoURL.size() <= 250000 &&
        data.postId is string && data.postId.size() <= 64 &&
        data.commentId is string && data.commentId.size() <= 64 &&
        data.violationId is string && data.violationId.size() <= 64 &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidImportantAnnouncement(data) {
      return data.keys().hasAll([
          'id', 'postId', 'title', 'excerpt', 'authorId',
          'authorName', 'authorPhotoURL', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'postId', 'title', 'excerpt', 'authorId',
          'authorName', 'authorPhotoURL', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 64 && data.postId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.excerpt is string && data.excerpt.size() >= 1 && data.excerpt.size() <= 280 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.authorPhotoURL is string && data.authorPhotoURL.size() <= 250000 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
          'id', 'adminId', 'adminName', 'action', 'targetUserId',
          'targetUserName', 'targetEntityId', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'adminId', 'adminName', 'action', 'targetUserId',
          'targetUserName', 'targetEntityId', 'summary', 'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.adminId is string && data.adminId.size() >= 1 && data.adminId.size() <= 128 &&
        data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 80 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 60 &&
        data.targetUserId is string && data.targetUserId.size() <= 128 &&
        data.targetUserName is string && data.targetUserName.size() <= 80 &&
        data.targetEntityId is string && data.targetEntityId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400 &&
        data.createdAt is timestamp;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'characterId', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'characterId', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        isValidId(data.characterId) &&
        data.createdAt is timestamp;
    }

    function isValidUsernameClaim(data) {
      return data.keys().hasAll(['uid', 'username', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        isValidUsername(data.username) &&
        data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    // 1. Public Archive: Characters (Guest/User read; Admin write)
    match /characters/{characterId} {
      allow get: if isValidId(characterId);
      allow list: if true;
      allow create: if isValidId(characterId) &&
        isValidCharacter(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().createdBy == request.auth.uid &&
        isAdmin();
      allow update: if isValidId(characterId) &&
        isValidCharacter(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdBy == existing().createdBy &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'id', 'name', 'image', 'subtitle', 'genre', 'tags',
          'description', 'plot', 'link', 'linkLabel', 'pinned', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isValidId(characterId) && isAdmin();
    }

    // 2. Public Archive: Categories (Guest/User read; Admin write)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'order', 'updatedAt']) &&
        isAdmin();
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 3. Public Archive: Independent Decorative Gallery (Guest/User read; Admin write)
    match /gallery/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) &&
        isValidGalleryItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isValidId(itemId) &&
        isValidGalleryItem(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'image', 'caption', 'date', 'category', 'span', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // 4. Public Archive: Music Library & Audio Chunks (Guest/User listen; Admin manage)
    match /tracks/{trackId} {
      allow get: if isValidId(trackId);
      allow list: if true;
      allow create: if isValidId(trackId) &&
        isValidTrack(incoming()) &&
        incoming().id == trackId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().createdBy == request.auth.uid &&
        isAdmin();
      allow update: if isValidId(trackId) &&
        isValidTrack(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdBy == existing().createdBy &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'artist', 'description', 'cover',
          'audioType', 'audioUrl', 'audioMimeType', 'audioFileName',
          'audioFileSize', 'audioChunkCount', 'audioVersion',
          'duration', 'order', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isValidId(trackId) && isAdmin();

      match /audioChunks/{chunkId} {
        allow get: if isValidId(trackId) && isValidId(chunkId);
        allow list: if isValidId(trackId) && resource.data.trackId == trackId;
        allow create: if isValidId(trackId) &&
          isValidId(chunkId) &&
          isValidTrackAudioChunk(incoming()) &&
          incoming().trackId == trackId &&
          incoming().createdAt == request.time &&
          isAdmin() &&
          exists(/databases/$(database)/documents/tracks/$(trackId));
        allow update: if false;
        allow delete: if isValidId(trackId) && isValidId(chunkId) && isAdmin();
      }
    }

    // 5. PII-Isolated User Profiles (email private; username/email/role immutable for regular users)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isOwner(userId) &&
        (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().username == existing().username &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /favorites/{characterId} {
        allow get: if isValidId(userId) && isValidId(characterId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(characterId) &&
          isValidFavorite(incoming()) &&
          incoming().userId == userId &&
          incoming().characterId == characterId &&
          incoming().createdAt == request.time &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/characters/$(characterId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(characterId) && isOwner(userId);
      }
    }

    // 6. Non-PII Public Display Profiles (live avatar, displayName & verified role for Forum/Comments)
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().updatedAt == request.time &&
        isOwner(userId) &&
        (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isValidId(userId) &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time && (
          (isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().username == existing().username &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 7. Public Forum: Posts (Guest read; Unrestricted User own CRUD; Admin pin/important/feature/moderate)
    match /forumPosts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create: if isValidId(postId) &&
        isVerified() &&
        isValidForumPost(incoming()) &&
        incoming().id == postId &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().authorRole == 'user' || (incoming().authorRole == 'admin' && isAdmin())) &&
        (incoming().isPinned == false || isAdmin()) &&
        (incoming().pinnedAt == 0 || isAdmin()) &&
        (incoming().pinOrder == 0 || isAdmin()) &&
        (incoming().isFeatured == false || isAdmin()) &&
        (!('isImportant' in incoming()) || incoming().isImportant == false || isAdmin()) &&
        (!('importantAnnouncedAt' in incoming()) || incoming().importantAnnouncedAt == 0 || isAdmin()) &&
        (isAdmin() || !isPostRestrictedNow());
      allow update: if isValidId(postId) &&
        isVerified() &&
        isValidForumPost(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().authorRole == existing().authorRole &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (existing().authorId == request.auth.uid &&
            !isPostRestrictedNow() &&
            incoming().isPinned == existing().isPinned &&
            incoming().pinnedAt == existing().pinnedAt &&
            incoming().pinOrder == existing().pinOrder &&
            incoming().isFeatured == existing().isFeatured &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'content', 'image', 'authorName', 'authorPhotoURL', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'content', 'image', 'isPinned', 'pinnedAt', 'pinOrder',
              'isFeatured', 'isImportant', 'importantAnnouncedAt',
              'authorName', 'authorPhotoURL', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(postId) && isVerified() && (
        existing().authorId == request.auth.uid || isAdmin()
      );
    }

    // 8. Public Forum: Comments & Replies (Guest read; Unrestricted User own CRUD; Admin delete)
    match /forumComments/{commentId} {
      allow get: if isValidId(commentId);
      allow list: if true;
      allow create: if isValidId(commentId) &&
        isVerified() &&
        isValidForumComment(incoming()) &&
        incoming().id == commentId &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().authorRole == 'user' || (incoming().authorRole == 'admin' && isAdmin())) &&
        (isAdmin() || !isCommentRestrictedNow()) &&
        exists(/databases/$(database)/documents/forumPosts/$(incoming().postId));
      allow update: if isValidId(commentId) &&
        isVerified() &&
        isValidForumComment(incoming()) &&
        incoming().id == existing().id &&
        incoming().postId == existing().postId &&
        incoming().parentCommentId == existing().parentCommentId &&
        incoming().authorId == existing().authorId &&
        incoming().authorRole == existing().authorRole &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().authorId == request.auth.uid &&
        (isAdmin() || !isCommentRestrictedNow()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'content', 'authorName', 'authorPhotoURL', 'updatedAt'
        ]);
      allow delete: if isValidId(commentId) && isVerified() && (
        existing().authorId == request.auth.uid || isAdmin()
      );
    }

    // 9. Public Forum: Post Likes (1 per user per post, immutable)
    match /forumLikes/{likeId} {
      allow get: if isValidId(likeId);
      allow list: if true;
      allow create: if isValidId(likeId) &&
        isVerified() &&
        isValidForumLike(incoming()) &&
        incoming().userId == request.auth.uid &&
        likeId == (incoming().postId + '_' + request.auth.uid) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/forumPosts/$(incoming().postId));
      allow update: if false;
      allow delete: if isValidId(likeId) && isVerified() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // 10. Forum Community Rules Configuration (Public read; Admin version bump & edit)
    match /forumRulesConfig/{docId} {
      allow get: if docId == 'current';
      allow list: if false;
      allow create: if docId == 'current' &&
        isValidForumRulesConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if docId == 'current' &&
        isValidForumRulesConfig(incoming()) &&
        incoming().version >= existing().version &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'version', 'title', 'intro', 'rules', 'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    // 11. Per-Account Forum Rules Acceptance
    match /forumRulesAcceptances/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidForumRulesAcceptance(incoming()) &&
        incoming().userId == userId &&
        incoming().acceptedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidForumRulesAcceptance(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().acceptedVersion >= existing().acceptedVersion &&
        incoming().acceptedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['acceptedVersion', 'acceptedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 12. Forum Moderation Violations & Appeals (Owner or Admin read; Owner may only file appeal; Admin moderates)
    match /forumViolations/{violationId} {
      allow get: if isValidId(violationId) && (
        isAdmin() || (isVerified() && existing().userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(violationId) &&
        isVerified() &&
        isValidForumViolation(incoming()) &&
        incoming().id == violationId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            incoming().userId == request.auth.uid &&
            incoming().status == 'unread' &&
            incoming().appealRequested == false &&
            incoming().appealReason == '' &&
            incoming().appealStatus == 'none' &&
            incoming().appealResolutionNote == '' &&
            incoming().adminNote == '' &&
            incoming().reviewedBy == ''
          )
        );
      allow update: if isValidId(violationId) &&
        isVerified() &&
        isValidForumViolation(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().incidentKey == existing().incidentKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (existing().userId == request.auth.uid &&
            existing().appealStatus == 'none' &&
            incoming().appealRequested == true &&
            incoming().appealStatus == 'pending' &&
            incoming().appealReason.size() >= 5 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'appealRequested', 'appealReason', 'appealStatus', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'appealStatus', 'appealResolutionNote', 'adminNote', 'reviewedBy', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(violationId) && isAdmin();
    }

    // 13. Per-Account Restrictions & Violation Counter (Monotonic for owners; Admin full control)
    match /userRestrictions/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isVerified() &&
        isValidUserRestriction(incoming()) &&
        incoming().userId == userId &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().warningCount >= 1 &&
            incoming().warningCount <= 10 &&
            incoming().updatedBy == 'system'
          )
        );
      allow update: if isValidId(userId) &&
        isVerified() &&
        isValidUserRestriction(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time && (
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'warningCount', 'status', 'postRestrictedUntil',
              'commentRestrictedUntil', 'suspendedUntil', 'reason', 'updatedBy', 'updatedAt'
            ])) ||
          (isOwner(userId) &&
            incoming().warningCount >= existing().warningCount &&
            incoming().warningCount <= existing().warningCount + 1 &&
            incoming().postRestrictedUntil >= existing().postRestrictedUntil &&
            incoming().commentRestrictedUntil >= existing().commentRestrictedUntil &&
            incoming().suspendedUntil >= existing().suspendedUntil &&
            incoming().updatedBy == 'system' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'warningCount', 'status', 'postRestrictedUntil',
              'commentRestrictedUntil', 'suspendedUntil', 'reason', 'updatedBy', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 14. Strictly Private Per-Account Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerified() && (
        existing().recipientId == request.auth.uid || isAdmin()
      );
      allow list: if isVerified() && resource.data.recipientId == request.auth.uid;
      allow create: if isValidId(notificationId) &&
        isVerified() &&
        isValidUserNotification(incoming()) &&
        incoming().id == notificationId &&
        incoming().isRead == false &&
        incoming().createdAt == request.time && (
          isAdmin() ||
          (incoming().type == 'interaction' &&
            incoming().actorId == request.auth.uid &&
            incoming().recipientId != request.auth.uid &&
            incoming().postId.size() >= 1 &&
            exists(/databases/$(database)/documents/forumPosts/$(incoming().postId))) ||
          (incoming().type == 'warning' &&
            incoming().recipientId == request.auth.uid &&
            incoming().violationId.size() >= 1) ||
          (incoming().type == 'system' &&
            incoming().subtype in ['admin_violation_alert', 'admin_appeal_alert'] &&
            incoming().actorId == request.auth.uid &&
            incoming().violationId.size() >= 1 &&
            exists(/databases/$(database)/documents/publicProfiles/$(incoming().recipientId)) &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().recipientId)).data.role == 'admin')
        );
      allow update: if isValidId(notificationId) &&
        isVerified() &&
        isValidUserNotification(incoming()) &&
        existing().recipientId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().recipientId == existing().recipientId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isValidId(notificationId) && isVerified() && (
        existing().recipientId == request.auth.uid || isAdmin()
      );
    }

    // 15. Public Important Admin Pinned Post Announcements (Non-PII popup feed; Admin-only write)
    match /importantAnnouncements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if true;
      allow create: if isValidId(announcementId) &&
        isValidImportantAnnouncement(incoming()) &&
        incoming().id == announcementId &&
        incoming().postId == announcementId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/forumPosts/$(incoming().postId));
      allow update: if isValidId(announcementId) &&
        isValidImportantAnnouncement(incoming()) &&
        incoming().id == existing().id &&
        incoming().postId == existing().postId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'excerpt', 'authorName', 'authorPhotoURL', 'active', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // 16. Immutable Append-Only Admin Moderation Audit Log
    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isValidAdminAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().adminId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // 17. Non-PII Username Uniqueness Reservations
    match /usernames/{username} {
      allow get: if isValidUsername(username);
      allow list: if false;
      allow create: if isValidUsername(username) &&
        isValidUsernameClaim(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().username == username &&
        incoming().createdAt == request.time &&
        isVerified();
      allow update: if false;
      allow delete: if isValidUsername(username) && (
        isAdmin() || (isVerified() && existing().uid == request.auth.uid)
      );
    }

    // 18. Trusted Admin Allowlist
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminUid) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminUid &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isValidId(adminUid) && isAdmin() && adminUid != request.auth.uid;
    }

    // 19. Startup Connection Probe
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }
  }
}
